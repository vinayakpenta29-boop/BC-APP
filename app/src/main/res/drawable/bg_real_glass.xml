<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Glass transparency -->
    <solid android:color="#40FFFFFF"/>

    <!-- Rounded glass -->
    <corners android:radius="32dp"/>

    <!-- Glass border highlight -->
    <stroke
        android:width="1.5dp"
        android:color="#80FFFFFF"/>

    <!-- Soft shine -->
    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp"/>

</shape>
