<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0f6fb"
    android:fillViewport="true">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/rootLayout"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 🔹 Toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgLock"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock"
                    android:layout_marginEnd="10dp"
                    android:visibility="visible"/>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_big_curve"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <ImageButton
                        android:id="@+id/btnUndo"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_small_curve"
                        android:src="@drawable/ic_undo"
                        android:padding="6dp"/>

                    <ImageButton
                        android:id="@+id/btnRedo"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_small_curve"
                        android:src="@drawable/ic_redo"
                        android:padding="6dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/menuButton"
                    android:text="⋮"
                    android:textSize="22sp"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Title -->
            <TextView
                android:text="Main BC Entry"
                android:textColor="#990F4B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Spinners -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <Spinner
                    android:id="@+id/spinnerBc"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_curved"/>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content"/>

                <Spinner
                    android:id="@+id/spinnerMember"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_curved"/>
            </LinearLayout>

            <!-- Date -->
            <EditText
                android:id="@+id/editPayDate"
                android:hint="Date"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_curved"
                android:layout_marginBottom="8dp"/>

            <!-- Amount -->
            <EditText
                android:id="@+id/editPayAmount"
                android:hint="Installment Amount"
                android:inputType="number"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_curved"
                android:layout_marginBottom="12dp"/>

            <!-- ADD Button -->
            <Button
                android:id="@+id/buttonAdd"
                android:text="ADD"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_add_ripple"
                android:layout_marginBottom="12dp"/>

            <!-- Table Header -->
            <TextView
                android:text="Main BC Table"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#990F4B"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"/>

                <androidx.appcompat.widget.SwitchCompat    
                  android:id="@+id/switchVertical"    
                  android:layout_width="wrap_content"    
                  android:layout_height="wrap_content"    
                  android:text="Vertical"    
                  android:visibility="gone"/>    

            <!-- 🔥 TABLE CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:elevation="6dp"
                android:padding="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Horizontal Table -->
                    <HorizontalScrollView
                        android:id="@+id/horizontalScroll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@+id/verticalSeekBar"
                        android:scrollbars="none">

                        <ScrollView
                            android:id="@+id/verticalScroll"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent">

                            <LinearLayout
                                android:id="@+id/tableContainer"
                                android:orientation="vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </ScrollView>

                    </HorizontalScrollView>

                    <!-- ✅ Vertical SeekBar -->
                    <SeekBar
                        android:id="@+id/verticalSeekBar"
                        android:layout_width="28dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:rotation="270"
                        android:max="1000"/>

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <!-- ✅ Horizontal SeekBar -->
            <SeekBar
                android:id="@+id/horizontalSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</ScrollView>
